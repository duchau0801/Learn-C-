        private void TxtTenThuoc_TextChanged(object sender, EventArgs e)
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                try
                {
                    conn.Open();
                    string query = "SELECT MaThuoc, LoaiThuoc FROM Thuoc WHERE TenThuoc = @TenThuoc";
                    SqlCommand cmd = new SqlCommand(query, conn);
                    cmd.Parameters.AddWithValue("@TenThuoc", TxtTenThuoc.Text.Trim());
                    SqlDataReader reader = cmd.ExecuteReader();
                    if (reader.Read())
                    {
                        TxtMaThuoc.Text = reader["MaThuoc"].ToString();
                        cmbLoaiThuoc.Text = reader["LoaiThuoc"].ToString();
                    }
                    else
                    {
                        TxtMaThuoc.Text = "";
                        cmbLoaiThuoc.Text = "";
                    }
                    reader.Close();
                }
                catch (Exception ex)
                {
                    // Không cần báo lỗi liên tục khi người dùng nhập
                }
            }
        }

