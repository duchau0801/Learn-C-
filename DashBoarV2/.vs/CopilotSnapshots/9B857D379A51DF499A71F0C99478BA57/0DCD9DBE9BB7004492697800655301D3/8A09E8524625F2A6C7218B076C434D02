        private void btnThem_Click_1(object sender, EventArgs e)
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                try
                {
                    conn.Open();
                    // Kiểm tra tên thuốc đã tồn tại chưa
                    string checkQuery = "SELECT SoLuongTon FROM Thuoc WHERE TenThuoc = @TenThuoc";
                    SqlCommand checkCmd = new SqlCommand(checkQuery, conn);
                    checkCmd.Parameters.AddWithValue("@TenThuoc", TxtTenThuoc.Text.Trim());
                    object exist = checkCmd.ExecuteScalar();

                    if (exist != null)
                    {
                        // Nếu tồn tại, cập nhật thông tin và cộng số lượng nhập vào tồn kho
                        int soLuongTonCu = Convert.ToInt32(exist);
                        int soLuongNhap = int.TryParse(TxtSoluong.Text.Trim(), out int sl) ? sl : 0;
                        int soLuongTonMoi = soLuongTonCu + soLuongNhap;

                        string updateQuery = @"
                            UPDATE Thuoc SET
                                MaThuoc = @MaThuoc,
                                LoaiThuoc = @LoaiThuoc,
                                DonViTinh = @DonViTinh,
                                GiaMua = @GiaMua,
                                GiaBan = @GiaBan,
                                SoLuongTon = @SoLuongTon
                            WHERE TenThuoc = @TenThuoc;
                        ";
                        SqlCommand updateCmd = new SqlCommand(updateQuery, conn);
                        updateCmd.Parameters.AddWithValue("@MaThuoc", TxtMaThuoc.Text.Trim());
                        updateCmd.Parameters.AddWithValue("@LoaiThuoc", cmbLoaiThuoc.Text.Trim());
                        updateCmd.Parameters.AddWithValue("@DonViTinh", cmbDonViThuoc.Text.Trim());
                        updateCmd.Parameters.AddWithValue("@GiaMua", decimal.TryParse(TxtGiaVon.Text.Trim(), out decimal gm) ? gm : 0);
                        updateCmd.Parameters.AddWithValue("@GiaBan", decimal.TryParse(TxtGiaBan.Text.Trim(), out decimal gb) ? gb : 0);
                        updateCmd.Parameters.AddWithValue("@SoLuongTon", soLuongTonMoi);
                        updateCmd.Parameters.AddWithValue("@TenThuoc", TxtTenThuoc.Text.Trim());
                        updateCmd.ExecuteNonQuery();
                    }
                    else
                    {
                        // Nếu chưa tồn tại, thêm mới thuốc
                        string insertQuery = @"
                            INSERT INTO Thuoc (MaThuoc, TenThuoc, LoaiThuoc, DonViTinh, GiaMua, GiaBan, SoLuongTon)
                            VALUES (@MaThuoc, @TenThuoc, @LoaiThuoc, @DonViTinh, @GiaMua, @GiaBan, @SoLuongTon);
                        ";
                        SqlCommand insertCmd = new SqlCommand(insertQuery, conn);
                        insertCmd.Parameters.AddWithValue("@MaThuoc", TxtMaThuoc.Text.Trim());
                        insertCmd.Parameters.AddWithValue("@TenThuoc", TxtTenThuoc.Text.Trim());
                        insertCmd.Parameters.AddWithValue("@LoaiThuoc", cmbLoaiThuoc.Text.Trim());
                        insertCmd.Parameters.AddWithValue("@DonViTinh", cmbDonViThuoc.Text.Trim());
                        insertCmd.Parameters.AddWithValue("@GiaMua", decimal.TryParse(TxtGiaVon.Text.Trim(), out decimal gm) ? gm : 0);
                        insertCmd.Parameters.AddWithValue("@GiaBan", decimal.TryParse(TxtGiaBan.Text.Trim(), out decimal gb) ? gb : 0);
                        insertCmd.Parameters.AddWithValue("@SoLuongTon", int.TryParse(TxtSoluong.Text.Trim(), out int sl) ? sl : 0);
                        insertCmd.ExecuteNonQuery();
                    }

                    // Thêm ngày hết hạn vào ChiTietPhieuNhap (nếu cần)
                    string insertCTPN = @"
                        INSERT INTO ChiTietPhieuNhap (MaPhieuNhap, MaThuoc, SoLuongNhap, HanSuDung)
                        VALUES (@MaPhieuNhap, @MaThuoc, @SoLuongNhap, @HanSuDung);
                    ";
                    SqlCommand ctpnCmd = new SqlCommand(insertCTPN, conn);
                    ctpnCmd.Parameters.AddWithValue("@MaPhieuNhap", 1); // hoặc lấy mã phiếu nhập phù hợp
                    ctpnCmd.Parameters.AddWithValue("@MaThuoc", TxtMaThuoc.Text.Trim());
                    ctpnCmd.Parameters.AddWithValue("@SoLuongNhap", int.TryParse(TxtSoluong.Text.Trim(), out int slNhap) ? slNhap : 0);
                    ctpnCmd.Parameters.AddWithValue("@HanSuDung", dateTimePicker1.Value);
                    ctpnCmd.ExecuteNonQuery();

                    MessageBox.Show("Thêm/Cập nhật thuốc thành công!");

                    // Hiển thị dữ liệu mới lên dgvViewthuoc nếu viewmedicine đang mở
                    foreach (Control ctrl in this.Parent.Controls)
                    {
                        if (ctrl is viewmedicine vm)
                        {
                            vm.LoadThuocData();
                        }
                    }
                    UpdateChartLoaiThuoc(); // cập nhật biểu đồ sau khi thêm thuốc
                    ClearInputFields(); // clear các trường nhập liệu
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Lỗi: " + ex.Message);
                }
            }
        }

