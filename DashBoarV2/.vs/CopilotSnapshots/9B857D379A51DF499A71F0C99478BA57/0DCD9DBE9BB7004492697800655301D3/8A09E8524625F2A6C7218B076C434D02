        public void UpdateChartLoaiThuoc()
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                try
                {
                    conn.Open();
                    string query = @"
                        SELECT t.LoaiThuoc, COUNT(*) AS SoLanNhap
                        FROM ChiTietPhieuNhap ctpn
                        JOIN Thuoc t ON ctpn.MaThuoc = t.MaThuoc
                        GROUP BY t.LoaiThuoc
                    ";
                    SqlCommand cmd = new SqlCommand(query, conn);
                    SqlDataReader reader = cmd.ExecuteReader();

                    chartThuoc.Series.Clear();
                    Series series = new Series("Số lần nhập", ViewType.Bar);
                    Random rand = new Random();

                    while (reader.Read())
                    {
                        string loaiThuoc = reader["LoaiThuoc"].ToString();
                        int soLanNhap = Convert.ToInt32(reader["SoLanNhap"]);
                        SeriesPoint point = new SeriesPoint(loaiThuoc, soLanNhap);
                        series.Points.Add(point);
                    }
                    chartThuoc.Series.Add(series);

                    // Set random color for each bar
                    for (int i = 0; i < series.Points.Count; i++)
                    {
                        Color randomColor = Color.FromArgb(rand.Next(100, 256), rand.Next(100, 256), rand.Next(100, 256));
                        series.Points[i].Color = randomColor;
                    }

                    if (chartThuoc.Diagram is XYDiagram diagram)
                    {
                        diagram.AxisX.Title.Text = "Loại thuốc";
                        diagram.AxisY.Title.Text = "Số lần nhập";
                        diagram.AxisX.Title.Visibility = DevExpress.Utils.DefaultBoolean.True;
                        diagram.AxisY.Title.Visibility = DevExpress.Utils.DefaultBoolean.True;
                    }

                    reader.Close();
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Lỗi khi cập nhật biểu đồ: " + ex.Message);
                }
            }
        }

