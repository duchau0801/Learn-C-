        private bool isSaleExpanded = false;
        private void btnSale_Click_1(object sender, EventArgs e)
        {
            isSaleExpanded = !isSaleExpanded;
            panelSubMenuSale.Visible = isSaleExpanded;
            int submenuHeight = panelSubMenuSale.Height;

            if (isSaleExpanded)
            {
                pnlAccount.Top += submenuHeight;
                pnlCustomer.Top += submenuHeight;
            }
            else
            {
                pnlAccount.Top -= submenuHeight;
                pnlCustomer.Top -= submenuHeight;
            }
        }
