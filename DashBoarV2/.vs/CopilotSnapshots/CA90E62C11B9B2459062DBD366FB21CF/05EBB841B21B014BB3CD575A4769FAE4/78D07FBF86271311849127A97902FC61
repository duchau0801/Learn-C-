namespace DashBoarV2.USER
{
    public partial class addmedicine : UserControl
    {
        private string connectionString = "Server=DESKTOP-A444F8V\\SQLEXPRESS;Database=QuanLiNhaThuoc;Integrated Security=True;"; // Sửa lại thông tin kết nối phù hợp

        private void LoadLoaiThuoc()
        {
            using (SqlConnection conn = new SqlConnection(connectionString))
            {
                try
                {
                    conn.Open();
                    string query = "SELECT DISTINCT LoaiThuoc FROM Thuoc WHERE LoaiThuoc IS NOT NULL";
                    SqlCommand cmd = new SqlCommand(query, conn);
                    SqlDataReader reader = cmd.ExecuteReader();
                    cmbLoaiThuoc.Items.Clear();
                    while (reader.Read())
                    {
                        cmbLoaiThuoc.Items.Add(reader["LoaiThuoc"].ToString());
                    }
                    reader.Close();
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Lỗi kết nối dữ liệu: " + ex.Message);
                }
            }
        }

        private void addmedicine_Load(object sender, EventArgs e)
        {
            LoadLoaiThuoc();
        }

        public addmedicine()
        {
            InitializeComponent();
            this.Load += addmedicine_Load;
        }
    }
}
